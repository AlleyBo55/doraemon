{
  "manifest_version": 3,
  "name": "Doraemon Browser Companion",
  "version": "2.0.0",
  "description": "Captures browsing content from whitelisted sites for Doraemon's memory system",
  "permissions": ["tabs"],
  "host_permissions": [
    "https://twitter.com/*",
    "https://x.com/*",
    "https://www.reddit.com/*",
    "https://reddit.com/*",
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://youtu.be/*",
    "https://github.com/*",
    "https://news.ycombinator.com/*",
    "https://techcrunch.com/*",
    "https://www.theverge.com/*",
    "https://www.wired.com/*",
    "https://arstechnica.com/*",
    "https://dev.to/*",
    "https://medium.com/*",
    "https://*.medium.com/*",
    "https://stackoverflow.com/*",
    "https://*.manhwaz.com/*",
    "https://*.shinigami09.com/*",
    "https://outlook.office.com/*",
    "https://outlook.live.com/*",
    "https://teams.microsoft.com/*",
    "https://web.whatsapp.com/*",
    "https://*.slack.com/*",
    "https://discord.com/*",
    "https://www.moltbook.com/*",
    "https://moltbook.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://twitter.com/*",
        "https://x.com/*",
        "https://www.reddit.com/*",
        "https://reddit.com/*",
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://github.com/*",
        "https://news.ycombinator.com/*",
        "https://techcrunch.com/*",
        "https://www.theverge.com/*",
        "https://www.wired.com/*",
        "https://arstechnica.com/*",
        "https://dev.to/*",
        "https://medium.com/*",
        "https://*.medium.com/*",
        "https://stackoverflow.com/*",
        "https://*.manhwaz.com/*",
        "https://*.shinigami09.com/*",
        "https://outlook.office.com/*",
        "https://outlook.live.com/*",
        "https://teams.microsoft.com/*",
        "https://web.whatsapp.com/*",
        "https://*.slack.com/*",
        "https://discord.com/*",
        "https://www.moltbook.com/*",
        "https://moltbook.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  }
}
