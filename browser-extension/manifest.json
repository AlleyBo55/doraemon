{
  "manifest_version": 3,
  "name": "Doraemon Web Notifications",
  "version": "1.0.0",
  "description": "Send web notifications from Twitter, Outlook, Teams, and GitHub to Doraemon desktop mascot",
  "permissions": ["notifications"],
  "host_permissions": [
    "https://twitter.com/*",
    "https://x.com/*",
    "https://outlook.office.com/*",
    "https://outlook.live.com/*",
    "https://teams.microsoft.com/*",
    "https://github.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://twitter.com/*",
        "https://x.com/*",
        "https://outlook.office.com/*",
        "https://outlook.live.com/*",
        "https://teams.microsoft.com/*",
        "https://github.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  }
}
